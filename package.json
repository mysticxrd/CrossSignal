{
  "name": "crosssignal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "deploy:replay": "node scripts/deploy-replay.mjs",
    "factory:status": "node factory/status.mjs",
    "factory:seal": "node factory/seal.mjs",
    "demo:prepare": "node factory/05_ship/prepare.mjs",
    "verify:spec": "node factory/01_spec/verify.mjs",
    "verify:data": "tsx --test tests/flight-recorder-data.test.mjs && tsx factory/02_data/verify.mjs",
    "verify:build": "tsx --test tests/flight-recorder-build.test.mjs tests/supabase-trace-resolution.test.mjs tests/supabase-runtime.test.mjs && tsx factory/03_build/verify.mjs",
    "verify:release": "tsx factory/04_verify/verify.mjs",
    "verify:ship": "tsx factory/05_ship/verify.mjs",
    "verify:golden": "node scripts/generate-golden-revenue-leak-sql.mjs --check && node --test tests/golden-revenue-leak.test.mjs",
    "verify:investigator": "node --test tests/golden-revenue-leak.test.mjs tests/case-investigator.test.mjs",
    "verify:decision": "node scripts/generate-owner-decision-fixture-sql.mjs --check && node --test tests/golden-revenue-leak.test.mjs tests/case-investigator.test.mjs tests/case-decision.test.mjs",
    "verify:response": "node scripts/generate-owner-case-response-sql.mjs --check && node --test tests/golden-revenue-leak.test.mjs tests/case-investigator.test.mjs tests/case-decision.test.mjs tests/case-response.test.mjs",
    "verify:case-outcome": "node --test tests/golden-revenue-leak.test.mjs tests/case-investigator.test.mjs tests/case-decision.test.mjs tests/case-response.test.mjs tests/case-outcome.test.mjs",
    "replay:golden": "node scripts/run-golden-case-replay.mjs",
    "replay:matrix": "node scripts/run-case-scenario-matrix.mjs",
    "test": "node scripts/test-offline.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern _archive",
    "db:generate": "drizzle-kit generate",
    "replay:a01": "node --experimental-strip-types scripts/run-a01.mjs",
    "a01:prepare": "node --experimental-strip-types scripts/a01-case.mjs prepare",
    "verify:a01": "node --experimental-strip-types --test tests/a01.test.mjs",
    "test:legacy": "node scripts/test-offline.mjs --legacy",
    "test:build": "npm run build && node --test tests/rendered-html-build.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
