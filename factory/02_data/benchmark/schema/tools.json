[
  {
    "name": "revenue.inspect",
    "description": "Read revenue windows and received-window coverage; start exclusive, end inclusive, within supplied scope.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "limit",
        "cursor",
        "segment"
      ],
      "properties": {
        "start": {
          "type": "string",
          "maxLength": 24
        },
        "end": {
          "type": "string",
          "maxLength": 24
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 68
            },
            {
              "type": "null"
            }
          ]
        },
        "segment": {
          "anyOf": [
            {
              "enum": [
                "IN/debit",
                "IN/credit",
                "GB/debit"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
