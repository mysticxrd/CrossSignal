# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
*.tsbuildinfo
**/.wrangler/
/outputs/
/work/

# local workflow builds and durable local workflow state, including archives
**/.eve/
**/.output/

# Generated local CLI version cache; preserve on disk, exclude from releases.
/supabase/.temp/cli-latest

# Regenerated by npm run cf:typegen from the pinned Worker runtime config.
/worker-configuration.d.ts
